{
  "name": "@dallay/rook",
  "version": "${VERSION}",
  "description": "AI proxy/router that routes LLM requests to multiple providers (OpenAI, Anthropic, Ollama, Gemini, Groq) with fallback, caching, and audit logging.",
  "author": "Yuniel Acosta <info@yunielacosta.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dallay/cortex.git"
  },
  "homepage": "https://github.com/dallay/cortex#readme",
  "bugs": {
    "url": "https://github.com/dallay/cortex/issues"
  },
  "keywords": [
    "ai",
    "proxy",
    "router",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "groq",
    "ollama",
    "fallback",
    "caching",
    "audit"
  ],
  "bin": {
    "rook": "lib/index.js"
  },
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "scripts": {
    "test": "node --check lib/index.js",
    "prepublishOnly": "node --check lib/index.js"
  },
  "optionalDependencies": {
    "@dallay/rook-darwin-arm64": "${VERSION}",
    "@dallay/rook-darwin-x64": "${VERSION}",
    "@dallay/rook-linux-x64": "${VERSION}",
    "@dallay/rook-windows-x64": "${VERSION}"
  },
  "engines": {
    "node": ">=18"
  }
