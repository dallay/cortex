load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

# The Rust binary embeds the built dashboard through rust-embed, so the
# compiled assets must be available as Bazel inputs.
#
# The dashboard build is non-hermetic: it executes Vite through the pnpm
# toolchain installed in the source tree. Dashboard sources are not tracked;
# rerun the build after source changes. The build command runs outside the sandbox.
#
# To build the dashboard before compiling Rook, run:
#   bazel run //apps/rook/dashboard:build
sh_binary(
    name = "build",
    srcs = ["bazel/build_dashboard.sh"],
    data = [
        "bazel/lib.sh",
    ],
    visibility = ["//apps/rook:__subpackages__"],
    tags = [
        "no-sandbox",
        "non-hermetic",
        "requires-node-modules",
        "requires-pnpm",
    ],
)

# Filegroup that collects the built dashboard assets from the source tree.
# The `build` target must be executed (or `pnpm --filter @dallay/rook-dashboard exec vite build`)
# before this target can provide non-empty outputs.
filegroup(
    name = "dist",
    srcs = glob(
        ["dist/**"],
        allow_empty = True,
    ),
)

# Bazel targets for the dashboard delegate dependency management and execution
# to pnpm. The root pnpm-lock.yaml stays authoritative: no dashboard lockfile or
# workspace file is created, and node_modules must be installed beforehand.
#
# These targets are not hermetic: they execute inside the source tree because the
# dashboard toolchain (node_modules) is provided by pnpm, not by Bazel.

sh_test(
    name = "vitest",
    srcs = ["bazel/vitest.sh"],
    data = glob(
        [
            "bazel/lib.sh",
            "package.json",
            "src/**/*.ts",
            "src/**/*.tsx",
            "src/**/*.vue",
            "src/**/*.json",
            "vitest.config.ts",
            "vite.config.ts",
        ],
        allow_empty = True,
    ),
    local = True,
    tags = [
        "manual",
        "no-sandbox",
        "non-hermetic",
        "requires-node-modules",
        "requires-pnpm",
    ],
)

sh_test(
    name = "typecheck",
    srcs = ["bazel/typecheck.sh"],
    data = glob(
        [
            "bazel/lib.sh",
            "package.json",
            "src/**/*.ts",
            "src/**/*.tsx",
            "src/**/*.vue",
            "tsconfig.json",
            "tsconfig.node.json",
            "env.d.ts",
        ],
        allow_empty = True,
    ),
    local = True,
    tags = [
        "manual",
        "no-sandbox",
        "non-hermetic",
        "requires-node-modules",
        "requires-pnpm",
    ],
)

sh_test(
    name = "lint",
    srcs = ["bazel/lint.sh"],
    data = glob(
        [
            "bazel/lib.sh",
            "biome.json",
            "package.json",
            "src/**/*.ts",
            "src/**/*.tsx",
            "src/**/*.vue",
            "src/**/*.json",
        ],
        allow_empty = True,
    ),
    local = True,
    tags = [
        "manual",
        "no-sandbox",
        "non-hermetic",
        "requires-node-modules",
        "requires-pnpm",
    ],
)

test_suite(
    name = "test_suite",
    tags = ["manual"],
    tests = [
        ":lint",
        ":typecheck",
        ":vitest",
    ],
)
