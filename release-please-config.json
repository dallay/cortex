{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "separate-pull-requests": true,
  "always-update": true,
  "include-component-in-tag": true,
  "tag-separator": "@",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation" },
    { "type": "style", "section": "Styles" },
    { "type": "refactor", "section": "Code Refactoring" },
    { "type": "build", "section": "Build System" },
    { "type": "ci", "section": "Continuous Integration" },
    { "type": "test", "section": "Tests" },
    { "type": "chore", "section": "Chores" }
  ],
  "packages": {
    "apps/rook": {
      "release-type": "rust",
      "component": "rook",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": true,
      "tag-separator": "@",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/rook/npm/rook/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/rook/npm/rook/package.json",
          "jsonpath": "$.optionalDependencies['@dallay/rook-darwin-x64']"
        },
        {
          "type": "json",
          "path": "apps/rook/npm/rook/package.json",
          "jsonpath": "$.optionalDependencies['@dallay/rook-darwin-arm64']"
        },
        {
          "type": "json",
          "path": "apps/rook/npm/rook/package.json",
          "jsonpath": "$.optionalDependencies['@dallay/rook-linux-x64']"
        },
        {
          "type": "json",
          "path": "apps/rook/npm/rook/package.json",
          "jsonpath": "$.optionalDependencies['@dallay/rook-windows-x64']"
        },
        {
          "type": "json",
          "path": "apps/rook/npm/rook-darwin-arm64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/rook/npm/rook-darwin-x64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/rook/npm/rook-linux-x64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/rook/npm/rook-windows-x64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/rook/dashboard/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "apps/huginn": {
      "release-type": "rust",
      "component": "huginn",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": true,
      "tag-separator": "@"
    }
  },
  "draft": false,
  "prerelease": false,
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    }
  ]
}
