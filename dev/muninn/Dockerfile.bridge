FROM rust:1.99.1-slim@sha256:b8e062b1c3a80183df83d9ba187cadd2b5ab84bc78d453dbfeb2fccd5f982247 AS builder
USER 1000:1000
ENV CARGO_HOME=/tmp/cargo CARGO_TARGET_DIR=/tmp/target CARGO_NET_OFFLINE=true
ARG MUNINN_BRIDGE_FEATURES=""
WORKDIR /tmp/build
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY apps ./apps
COPY third_party/candle-core ./third_party/candle-core
COPY dev/muninn/fixtures/artifact-lock.json ./dev/muninn/fixtures/artifact-lock.json
COPY dev/muninn/bridge ./dev/muninn/bridge
COPY dev/muninn/requirements-minilm-tokenizer.txt dev/muninn/minilm_tokenizer_reference.py ./dev/muninn/
RUN if [ "$MUNINN_BRIDGE_FEATURES" = "h5-diagnostic" ]; then \
      cargo +1.99.1 build --offline --locked --manifest-path dev/muninn/bridge/Cargo.toml --features "$MUNINN_BRIDGE_FEATURES" --bin muninn-bridge-spike; \
    elif [ -z "$MUNINN_BRIDGE_FEATURES" ]; then \
      cargo +1.99.1 build --offline --locked --manifest-path dev/muninn/bridge/Cargo.toml --bin muninn-bridge-spike; \
    else \
      echo "unsupported Muninn bridge feature" >&2; exit 64; \
    fi
RUN if [ "$MUNINN_BRIDGE_FEATURES" = "h5-diagnostic" ]; then \
      cargo +1.99.1 test --offline --locked --manifest-path dev/muninn/bridge/Cargo.toml --features "$MUNINN_BRIDGE_FEATURES" --lib --no-run; \
    elif [ -z "$MUNINN_BRIDGE_FEATURES" ]; then \
      cargo +1.99.1 test --offline --locked --manifest-path dev/muninn/bridge/Cargo.toml --lib --no-run; \
    else \
      echo "unsupported Muninn bridge feature" >&2; exit 64; \
    fi \
    && find /tmp/target/debug/deps -type f -executable -name 'muninn_bridge_spike-*' -exec cp {} /tmp/muninn-storage-tests \;
RUN cargo test --offline --locked --manifest-path dev/muninn/bridge/Cargo.toml --example prepare_minilm --no-run \
    && find /tmp/target/debug/examples -type f -executable -name 'prepare_minilm-*' -exec cp {} /tmp/muninn-prepare-tests \;

FROM python:3.13.18-slim@sha256:76baad6037690d6e8c4397fbcaef17bca6f19eecef822b708fe8fa3417d30bb5
COPY --from=builder /tmp/target/debug/muninn-bridge-spike /usr/local/bin/muninn-bridge-spike
COPY --from=builder /tmp/muninn-storage-tests /usr/local/bin/muninn-storage-tests
COPY --from=builder /tmp/muninn-prepare-tests /usr/local/bin/muninn-prepare-tests
COPY docs/muninn/licenses/candle-0.11.0-MIT.txt /usr/share/licenses/muninn/candle-MIT.txt
COPY docs/muninn/licenses/CANDLE-NOTICE.md /usr/share/licenses/muninn/CANDLE-NOTICE.md
COPY third_party/candle-core/LICENSE /usr/share/licenses/muninn/Apache-2.0.txt
USER 7474:7474
ENTRYPOINT ["/usr/local/bin/muninn-bridge-spike"]
