load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "rook_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "rook_core",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    deps = ["//crates/domain/shared-kernel:shared_kernel"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "rook_core_unit_test",
    crate = ":rook_core",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    edition = crate_edition(),
    deps = ["//crates/domain/shared-kernel:shared_kernel"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

rust_test(
    name = "descriptor_table",
    crate_name = "descriptor_table",
    edition = crate_edition(),
    srcs = ["tests/descriptor_table.rs"],
    deps = [":rook_core", "//crates/domain/shared-kernel:shared_kernel"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

rust_test(
    name = "endpoint_policy",
