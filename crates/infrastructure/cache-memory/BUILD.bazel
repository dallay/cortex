load("@crates//:defs.bzl", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "cache_memory",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "cache_memory",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    deps = [
        "//crates/domain/shared-kernel:shared_kernel",
        "//crates/domain/rook-core:rook_core",
    ] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "cache_memory_unit_test",
    crate = ":cache_memory",
    edition = crate_edition(),
    deps = [
        "//crates/domain/shared-kernel:shared_kernel",
        "//crates/domain/rook-core:rook_core",
    ] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)
