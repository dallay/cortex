{
  "tools": [
    {
      "name": "memory_search",
      "title": "Memory Search",
      "description": "Search across all memory types using hybrid vector + graph search.\n\nFinds relevant messages, entities, preferences, and reasoning traces.\nUse this to recall stored information or find related context.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "Natural language search query."
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "description": "Maximum results per memory type (default: 10)."
          },
          "memory_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Types to search. Options: 'messages', 'entities',\n'preferences', 'traces'. Defaults to messages, entities, preferences."
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter message search to a specific session."
          },
          "threshold": {
            "default": 0.7,
            "type": "number",
            "description": "Similarity threshold 0.0-1.0 (default: 0.7)."
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "memory_get_context",
      "title": "Memory Get Context",
      "description": "Get assembled context from all memory types for the current session.\n\nReturns conversation history, relevant entities/preferences, and similar\npast reasoning traces, formatted for LLM consumption. Call this at the\nstart of each conversation to load relevant memories.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Session to get context for (uses current session if not set)."
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional search query to focus context retrieval."
          },
          "max_items": {
            "default": 10,
            "type": "integer",
            "description": "Maximum items per memory type (default: 10)."
          },
          "include_short_term": {
            "default": true,
            "type": "boolean",
            "description": "Include conversation history (default: true)."
          },
          "include_long_term": {
            "default": true,
            "type": "boolean",
            "description": "Include entities and preferences (default: true)."
          },
          "include_reasoning": {
            "default": true,
            "type": "boolean",
            "description": "Include similar reasoning traces (default: true)."
          }
        },
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "memory_store_message",
      "title": "Memory Store Message",
      "description": "Store a message in conversation memory.\n\nAutomatically triggers entity extraction, preference detection,\nand fact extraction from the message content. Use this to persist\nimportant user messages, assistant responses, or system events.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string",
            "description": "The message text content."
          },
          "role": {
            "default": "user",
            "type": "string",
            "description": "Message role - 'user', 'assistant', or 'system' (default: 'user')."
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Session ID (uses current session if not set)."
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional metadata to attach (e.g., model, source)."
          }
        },
        "required": [
          "content"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "memory_add_entity",
      "title": "Memory Add Entity",
      "description": "Create or update an entity in the knowledge graph.\n\nRuns entity resolution against existing entities to avoid duplicates.\nIf a close match is found, the entity may be merged or flagged.\n\nEntity types follow POLE+O: PERSON, OBJECT, LOCATION, EVENT, ORGANIZATION.\nEach supports optional subtypes (e.g., OBJECT:VEHICLE, LOCATION:ADDRESS).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Entity name (e.g., 'John Smith', 'Acme Corp')."
          },
          "entity_type": {
            "type": "string",
            "description": "POLE+O type in UPPER_CASE."
          },
          "subtype": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional subtype (e.g., 'VEHICLE', 'COMPANY')."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Entity description."
          },
          "aliases": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Alternative names for the entity."
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Additional metadata."
          }
        },
        "required": [
          "name",
          "entity_type"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "memory_add_preference",
      "title": "Memory Add Preference",
      "description": "Record a user preference for personalization.\n\nStore explicit or inferred user preferences with categorization.\nThese are used to personalize future interactions.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "description": "Preference category (e.g., 'food', 'music', 'communication_style')."
          },
          "preference": {
            "type": "string",
            "description": "The preference text (e.g., 'Prefers dark mode')."
          },
          "context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional context about when/why the preference was expressed."
          },
          "confidence": {
            "default": 1.0,
            "type": "number",
            "description": "Confidence score 0.0-1.0 (default: 1.0)."
          }
        },
        "required": [
          "category",
          "preference"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "memory_add_fact",
      "title": "Memory Add Fact",
      "description": "Store a subject-predicate-object fact triple.\n\nRecords declarative knowledge as a structured triple with optional\ntemporal validity bounds and arbitrary metadata.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "subject": {
            "type": "string",
            "description": "The subject of the fact (e.g., 'Earth')."
          },
          "predicate": {
            "type": "string",
            "description": "The relationship (e.g., 'has_radius_km')."
          },
          "object_value": {
            "type": "string",
            "description": "The object/value (e.g., '6371')."
          },
          "confidence": {
            "default": 1.0,
            "type": "number",
            "description": "Confidence score 0.0-1.0 (default: 1.0)."
          },
          "valid_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ISO date string for when this fact becomes valid."
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ISO date string for when this fact expires."
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Additional metadata (e.g., scope, stack_tags, temporality)."
          }
        },
        "required": [
          "subject",
          "predicate",
          "object_value"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    }
  ],
  "resources": [],
  "resourceTemplates": [
    {
      "name": "get_context",
      "uriTemplate": "memory://context/{session_id}",
      "description": "Assembled context for a session.\n\nReturns conversation history, relevant entities, preferences,\nand similar reasoning traces for the given session. Suitable\nfor embedding in the system prompt at conversation start.",
      "mimeType": "text/plain",
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    }
  ],
  "prompts": [
    {
      "name": "memory-conversation",
      "description": "Initialize a memory-aware conversation.\n\nLoads context from memory and instructs Claude on how to use\nmemory tools throughout the conversation. Use at the start\nof any conversation that should leverage stored memories.",
      "arguments": [
        {
          "name": "session_id",
          "description": "Provide a value matching the following JSON schema: {\"type\":\"string\"}. Encode non-string values as JSON.",
          "required": false
        }
      ],
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    }
  ]
}