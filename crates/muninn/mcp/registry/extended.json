    {
      "name": "memory_add_entity",
      "title": "Memory Add Entity",
      "description": "Create or update an entity in the knowledge graph.\n\nRuns entity resolution against existing entities to avoid duplicates.\nIf a close match is found, the entity may be merged or flagged.\n\nEntity types follow POLE+O: PERSON, OBJECT, LOCATION, EVENT, ORGANIZATION.\nEach supports optional subtypes (e.g., OBJECT:VEHICLE, LOCATION:ADDRESS).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Entity name (e.g., 'John Smith', 'Acme Corp')."
          },
          "entity_type": {
            "type": "string",
            "description": "POLE+O type in UPPER_CASE."
          },
          "subtype": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional subtype (e.g., 'VEHICLE', 'COMPANY')."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Entity description."
          },
          "aliases": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Alternative names for the entity."
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Additional metadata."
          }
        },
        "required": [
          "name",
          "entity_type"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
