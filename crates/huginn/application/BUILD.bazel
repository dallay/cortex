# Cargo enables `test-hooks` on the package for this required-feature integration test.
rust_library(
    name = "huginn_application_test_hooks",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "huginn_application",
    crate_root = "src/lib.rs",
    crate_features = ["test-hooks"],
    edition = crate_edition(),
    deps = ["//crates/huginn/core:huginn_core"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

