load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["wit/experimental-rust-outline/outline.wit"])

rust_library(
    name = "huginn_plugin_api",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "huginn_plugin_api",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    deps = ["//crates/huginn/core:huginn_core"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "huginn_plugin_api_unit_test",
    crate = ":huginn_plugin_api",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    edition = crate_edition(),
    deps = ["//crates/huginn/core:huginn_core"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

rust_test(
    name = "agent_loop",
    crate_name = "agent_loop",
    srcs = ['tests/agent_loop.rs'],
    edition = crate_edition(),
    deps = [":huginn_plugin_api", "//crates/huginn/core:huginn_core"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

rust_test(
    name = "contract",
    crate_name = "contract",
    srcs = ['tests/contract.rs'],
    edition = crate_edition(),
    deps = [":huginn_plugin_api", "//crates/huginn/core:huginn_core"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

rust_test(
    name = "hooks",
    crate_name = "hooks",
    srcs = ['tests/hooks.rs'],
    edition = crate_edition(),
    deps = [":huginn_plugin_api", "//crates/huginn/core:huginn_core"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

rust_test(
    name = "tools",
    crate_name = "tools",
    srcs = ['tests/tools.rs'],
    edition = crate_edition(),
    deps = [":huginn_plugin_api", "//crates/huginn/core:huginn_core"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

rust_test(
    name = "workflows",
    crate_name = "workflows",
    srcs = ['tests/workflows.rs'],
    edition = crate_edition(),
    deps = [":huginn_plugin_api", "//crates/huginn/core:huginn_core"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)
