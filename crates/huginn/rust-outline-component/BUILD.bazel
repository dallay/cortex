load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])
# Cargo also emits a cdylib; rules_rust rust_library models the rlib only.

rust_library(
    name = "huginn_rust_outline_component",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "huginn_rust_outline_component",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    deps = ['//crates/huginn/outline-bindings:huginn_outline_bindings'] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "huginn_rust_outline_component_unit_test",
    crate = ":huginn_rust_outline_component",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    edition = crate_edition(),
    deps = ['//crates/huginn/outline-bindings:huginn_outline_bindings'] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

rust_test(
    name = "outline",
    crate_name = "outline",
    srcs = ['tests/outline.rs'],
    edition = crate_edition(),
    deps = [":huginn_rust_outline_component"] + ['//crates/huginn/outline-bindings:huginn_outline_bindings'] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)
