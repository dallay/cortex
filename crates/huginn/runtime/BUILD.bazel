rust_test(
    name = "coding_workflow",
    crate_name = "coding_workflow",
    srcs = ['tests/coding_workflow.rs', 'tests/support/runfiles.rs'],
    data = ["//crates/huginn/runtime:tests/fixtures/mcp_server.py"],
    edition = crate_edition(),
    # The shell tool applies its own macOS Seatbelt profile through
    # /usr/bin/sandbox-exec. Seatbelt cannot nest inside Bazel's darwin-sandbox
    # ("sandbox-exec: sandbox_apply: Operation not permitted"), so the product
    # sandbox would silently never run and the assertions on the sandboxed
    # command would fail. "local" keeps the product sandbox under test and
    # only drops Bazel's outer macOS sandbox for this target.
    local = True,
    deps = [":huginn_runtime", '//crates/huginn/core:huginn_core'] + ['//crates/huginn/application:huginn_application', '//crates/huginn/guards:huginn_guards', '//crates/huginn/plugin-api:huginn_plugin_api'] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

