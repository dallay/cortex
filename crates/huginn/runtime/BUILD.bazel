rust_test(
    name = "huginn_runtime_unit_test",
    crate = ":huginn_runtime",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    edition = crate_edition(),
    # The unit tests cover the macOS Seatbelt shell sandbox, which cannot nest
    # inside Bazel's darwin-sandbox. See the note on :coding_workflow.
    local = True,
    # muninn-mcp is a dev-dependency used by src/mcp.rs under #[cfg(test)].
    # The dev-dependency alias resolves to a test-hooks target that this
    # crate does not publish, so the plain crate is wired in explicitly.
    deps = ['//crates/huginn/application:huginn_application', '//crates/huginn/guards:huginn_guards', '//crates/muninn/mcp:muninn_mcp'] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

