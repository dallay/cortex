module(
    name = "cortex",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.75.0")
# Keep local Cargo patches relocatable across Bazel checkouts.
single_version_override(
    module_name = "rules_rust",
    patches = ["//dev/bazel:rules_rust_relative_local_crates.patch"],
    patch_strip = 1,
)
bazel_dep(name = "rules_shell", version = "0.10.0")

# JavaScript/Node.js toolchain for the dashboard (hermetic Bazel build)
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "aspect_rules_js", version = "3.6.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.100.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "wasmtime",
    version = "=50.0.2",
    default_features = False,
    features = ["anyhow", "async", "component-model", "cranelift", "runtime", "std"],
    repositories = ["crates"],
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.Bazel.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

# Node.js toolchain — matches CI (Node 26)
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    node_version = "26.0.0",
)
use_repo(node, "nodejs_toolchains")
register_toolchains("@nodejs_toolchains//:all")

# Resolve dashboard dependencies from pnpm-lock.yaml
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")
